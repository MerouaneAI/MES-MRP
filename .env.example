# Database
DATABASE_URL=postgres://erp:changeme@localhost:5432/erp
POSTGRES_PASSWORD=changeme

# Redis
REDIS_URL=redis://localhost:6379

# NextAuth v5 — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# Session lifetime (seconds). 12h shift-friendly default.
AUTH_SESSION_MAXAGE=43200

# Where BullMQ writes generated PDFs
STORAGE_DIR=./storage

# Login rate limit (per email)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# First-run admin bootstrap
ADMIN_EMAIL=admin@factory.local
ADMIN_PASSWORD=ChangeMe123!