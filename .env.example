# Database
DATABASE_URL=postgres://erp:changeme@localhost:5432/erp
POSTGRES_PASSWORD=changeme

# Redis
REDIS_URL=redis://localhost:6379

# NextAuth v5 — generate with: npx auth secret   (or openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string
AUTH_TRUST_HOST=true

# Where BullMQ writes generated PDFs (a shared volume in Docker)
STORAGE_DIR=./storage

# --- added in Phase 5 ---
# Public URL the app is served on (behind the Caddy reverse proxy)
AUTH_URL=https://erp.factory.local
AUTH_TRUST_HOST=true

# First-run admin bootstrap (used once by scripts/create-admin.ts)
ADMIN_EMAIL=admin@factory.local
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Backups
BACKUP_DIR=/mnt/backup/erp
KEEP_DAYS=14